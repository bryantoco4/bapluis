.essential-upsell-overlay {
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: linear-gradient(36deg, rgba(0,0,0,0.9) 30%, rgba(0,0,0,0.4) 100%);
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 80px 24px 0;
  opacity: 0;
  transition: opacity 300ms ease;
  cursor: pointer;
}
.essential-upsell-overlay--visible {
  opacity: 1;
}
.essential-upsell-overlay--dismissed {
  opacity: 0;
  pointer-events: none;
}
.essential-upsell-overlay__arrow {
  position: absolute;
  top: 20px;
  right: 32px;
  width: 25vw;
  height: 25vw;
  max-width: 300px;
  max-height: 300px;
}
.essential-upsell-overlay__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12px;
  max-width: 280px;
  position: relative;
  margin: auto;
  line-height: 32px;
  font-size: 24px;
  text-align: center;
}
@media (max-width: 768px) {
  .essential-upsell-overlay__card {
    margin: 10vw auto auto auto;
  }
}
.essential-upsell-overlay__logo {
  width: 54px;
  height: 48px;
  margin-bottom: 8px;
  display: block;
}
.essential-upsell-overlay__heading {
  font-size: 24px;
  line-height: 40px;
  font-weight: 800;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  margin: 0;
}
.essential-upsell-overlay__text {
  font-size: 20px;
  line-height: 28px;
  font-weight: 400;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  margin: 0;
}
